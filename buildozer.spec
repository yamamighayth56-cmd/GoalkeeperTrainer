[app]

# اسم التطبيق
title = Goalkeeper Training

# اسم الحزمة
package.name = goalkeeper

# الدومين
package.domain = org.goalkeeper

# ملف الدخول
source.dir = .

# امتدادات الملفات المطلوبة
source.include_exts = py,png,jpg,kv,atlas

# النسخة
version = 1.0

# المكتبات
requirements = python3,kivy

# اتجاه الشاشة
orientation = portrait

# شاشة كاملة
fullscreen = 0


[buildozer]

# مستوى التحذيرات
log_level = 2

# وضع التحذيرات
warn_on_root = 1